{
  "name": "zhixing-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test --config playwright.teaching.config.ts",
    "test:api": "node --experimental-transform-types --test tests/api-client.test.ts",
