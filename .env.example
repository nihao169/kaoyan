DATABASE_URL=sqlite:///data/platform.db
DATA_DIR=data
ALLOWED_ORIGIN=http://127.0.0.1:5173
SECURE_COOKIES=false
SESSION_HOURS=8
# DeepSeek official endpoint; never append /chat/completions here.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
# Alternatively use the Windows user environment variable DEEPSEEK_API_KEY.
MODEL_TIMEOUT=30
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=main
EMBEDDING_LOCAL_ONLY=true
# Optional full path to LibreOffice soffice.exe (DOCX fixed-layout PDF conversion).
DOCUMENT_CONVERTER=
MODEL_INPUT_PRICE=0.3
MODEL_OUTPUT_PRICE=1.2
MODEL_PRICE_VERSION=deepseek-flash-2026-10-28-peak-USD-estimate
# V2 isolated integration; start-v2.ps1 supplies database and secret values.
DEEPTUTOR_URL=
DEEPTUTOR_BRIDGE_SECRET=
DEEPTUTOR_TIMEOUT=120
# Preview only: enable after configuring a compatible embedding model in DeepTutor.
DEEPTUTOR_NATIVE_KNOWLEDGE=false
DEEPTUTOR_NATIVE_QUESTIONS=false
DEEPTUTOR_NATIVE_TEACHER_QUESTIONS=false
DEEPTUTOR_NATIVE_LESSONS=false
# Preview: route newly created advisory teacher and student jobs through DeepTutor.
DEEPTUTOR_STRUCTURED_TEACHER=false
# Optional project and organization IDs, separated by spaces.
DEEPTUTOR_PRACTICE_PROJECTS=
DEEPTUTOR_RECORDS_PROJECTS=
DEEPTUTOR_TEACHER_BANK_ORGS=
